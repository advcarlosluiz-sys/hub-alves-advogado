{
  "name": "landingpage-hub-admin",
  "version": "1.0.0",
  "description": "Portal Administrativo, Segurança, Logs e Backups do site Carlos Luiz Alves Advocacia",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "backup:local": "node scripts/backup-local.js",
    "backup:verify": "node scripts/backup-verify.js",
    "restore:local": "node scripts/restore-local.js",
    "security:audit": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
